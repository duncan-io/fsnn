YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match a redirect URI allowed on the Yahoo app. While next dev is running, connect from /admin.
YAHOO_REDIRECT_URI=http://127.0.0.1:3000/admin/yahoo/callback
# Password for /admin. Leave empty to keep the page locked.
ADMIN_PASSWORD=
# Public URL for the FSNN Postgres service on Railway. Append ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?sslmode=require
# MiniMax writes columns, The Dig, and illustrations. https://platform.minimax.io
MINIMAX_API_KEY=
# Optional. Defaults to MiniMax-M3.
MINIMAX_MODEL=
# Optional. Defaults to image-01.
MINIMAX_IMAGE_MODEL=
# Optional. Defaults to speech-2.6-hd.
MINIMAX_SPEECH_MODEL=
# Optional. Jerry's voice. Defaults to English_Persuasive_Man.
MINIMAX_VOICE_JERRY=
# Optional. Greg's voice. Defaults to English_Insightful_Speaker.
MINIMAX_VOICE_GREG=
# Public site URL for the podcast RSS feed. No trailing slash.
SITE_URL=http://127.0.0.1:3000
# Railway article-images bucket. Reference these from the bucket on the app service.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
# Required only when more than one Yahoo league is stored.
LEAGUE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Google search for a rostered player's week. Writers skip the lookup when this is empty.
SERPER_API_KEY=
